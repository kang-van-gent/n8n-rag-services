# Environment Configuration for Omise Cart Integration
# Copy this file to .env.local and update with your actual values

# Supabase Configuration (existing)
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Omise Payment Gateway Configuration (NEW - Required for Cart Integration)
REACT_APP_OMISE_PUBLIC_KEY=pkey_test_your_omise_public_key_here

# For production, use live keys:
# REACT_APP_OMISE_PUBLIC_KEY=pkey_live_your_omise_live_public_key_here

# Backend Configuration (for future backend implementation)
OMISE_SECRET_KEY=skey_test_your_secret_key_here
OMISE_WEBHOOK_SECRET=your_webhook_secret_here
OMISE_ENVIRONMENT=test

# Note: 
# - Only REACT_APP_* variables are available in the React frontend
# - Never commit actual API keys to version control!
# - Get your keys from https://dashboard.omise.co/